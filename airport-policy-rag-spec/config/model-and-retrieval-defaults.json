{
  "status": "proposed_defaults_verify_in_target_environment",
  "data_lake": false,
  "backend": "FastAPI",
  "frontend": "React + Vite (JavaScript)",
  "vector_store": "Memgraph",
  "metadata_store": "SQLite",
  "embedding": {
    "runtime": "sentence-transformers",
    "model": "google/embeddinggemma-300m",
    "resolved_revision": null,
    "gated": "accept the Gemma license on Hugging Face and authenticate locally; never commit the token",
    "builtin_prompts": "unused; inputs are formatted once in code",
    "dimensions": 768,
    "similarity": "cosine",
    "truncate": false,
    "over_limit": "refuse before encoding; sentence-transformers would truncate silently",
    "document_format": "title: {title_and_section} | text: {chunk}",
    "query_format": "task: search result | query: {question}"
  },
  "generation": {
    "runtime": "Ollama",
    "model": "qwen3:8b",
    "resolved_digest": null,
    "temperature": 0,
    "context_tokens": 8192,
    "evidence_budget_tokens": 3500,
    "output_tokens": 1024
  },
  "reranker": {
    "runtime": "sentence-transformers",
    "model": "cross-encoder/ms-marco-MiniLM-L6-v2",
    "resolved_revision": null,
    "maximum_pair_tokens": 512,
    "overflow_strategy": "source-linked sentence windows"
  },
  "chunking": {
    "strategy": "section-aware parent-child",
    "target_tokens": 300,
    "max_tokens": 400,
    "overlap_target_tokens": 50,
    "tokenizer": "pinned embedding tokenizer",
    "hard_boundaries": [
      "document_version",
      "parent_section"
    ],
    "reranker_pair_recheck": true
  },
  "retrieval": {
    "vector_k": 10,
    "keyword_k": 10,
    "keyword": {
      "method": "BM25, implemented locally",
      "k1": 1.5,
      "b": 0.75,
      "fields": "child text plus title and heading",
      "single_term_patterns": ["policy identifiers", "section numbers", "number-unit pairs"],
      "exact_match_boost": "documented constant, recorded per candidate"
    },
    "fusion": "reciprocal rank fusion",
    "rrf_constant": 60,
    "max_graph_hops": 1,
    "max_graph_additions": 10,
    "max_candidates": 30,
    "final_k": 5,
    "report_k": [
      3,
      5
    ]
  },
  "agents": {
    "framework": "Deep Agents",
    "max_tool_calls": 6,
    "max_delegation_depth": 1,
    "max_subagents": 2,
    "timeout_seconds": 120,
    "persistent_memory_across_runs": false
  },
  "data_governance_layer": false,
  "evaluation": {
    "development_cases": 12,
    "heldout_cases": 12,
    "minimum_generated_heldout_cases": 8,
    "target_candidate_recall": 0.9,
    "target_final_recall_at_5": 0.85,
    "target_fact_accuracy": 0.85,
    "required_citation_validity": 1,
    "answer_grading": "deterministic required/prohibited facts decide pass or fail",
    "llm_judge": {
      "role": "reported support score, never gating",
      "model": "same local chat model as generation; disclosed",
      "temperature": 0
    },
    "needle_check": {
      "index": "isolated evaluation index, never published",
      "queries": ["by code", "by paraphrase"],
      "modes": ["vector", "keyword", "hybrid", "hybrid_rerank"]
    }
  }
}
